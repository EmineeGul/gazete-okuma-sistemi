<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://jakarta.ee/xml/ns/persistence"
             version="3.1">
    <persistence-unit name="GazeteHaberPU" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>jdbc/gazeteHaberDS</jta-data-source>
        <class>entity.Kullanici</class>
        <class>entity.Kategori</class>
        <class>entity.GazeteKaynagi</class>
        <class>entity.Haber</class>
        <class>entity.FavoriHaber</class>
        <class>entity.Yorum</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
